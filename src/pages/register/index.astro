---
import Layout from '@/layouts/Layout.astro'

let error = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const username            = form.get('username')
  const email               = form.get('email')
  const password            = form.get('password')
  const password_confirmation = form.get('password_confirmation')

  if (password !== password_confirmation) {
    error = 'Las contraseñas no coinciden'
  } else {
    const res = await fetch(`${Astro.url.origin}/api/auth/register`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, email, password })
    })

    if (res.ok) {
      return Astro.redirect('/login')
    } else {
      const data = await res.json()
      error = data.error || 'Error al registrarse'
    }
  }
}
---

<Layout title="Registro">
  <section class="min-h-screen bg-[#f3f1e9] flex items-center justify-center px-4">
    <div class="w-full max-w-xl">
      <div class="bg-[#F4F3EF] rounded-2xl shadow-lg p-8 md:p-10">

        <div class="text-center mb-8">
          <h1 class="text-5xl font-bold tracking-widest uppercase mb-2 text-[#6C4637]">Recetópolis</h1>
          <h2 class="text-2xl font-semibold text-[#5a3a2d]">Registrar usuario</h2>
        </div>

        {error && (
          <div class="bg-red-50 text-red-600 text-md px-4 py-3 rounded-lg mb-6">
            {error}
          </div>
        )}

        <form method="POST" class="space-y-4">
          <div class="flex flex-col gap-1">
            <label for="username" class="text-md font-medium text-[#5a3a2d]">Username</label>
            <input
              type="text"
              name="username"
              id="username"
              placeholder="Ingrese su username"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <div class="flex flex-col gap-1">
            <label for="email" class="text-md font-medium text-[#5a3a2d]">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              placeholder="Ingrese su email"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <div class="flex flex-col gap-1">
            <label for="password" class="text-md font-medium text-[#5a3a2d]">Password</label>
            <input
              type="password"
              name="password"
              id="password"
              placeholder="••••••••"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <div class="flex flex-col gap-1">
            <label for="password_confirmation" class="text-md font-medium text-[#5a3a2d]">Confirmar Password</label>
            <input
              type="password"
              name="password_confirmation"
              id="password_confirmation"
              placeholder="••••••••"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 mt-2 bg-[#6C4637] text-white rounded-xl font-semibold text-sm hover:bg-[#5a3a2d] transition"
          >
            Registrar
          </button>
        </form>

        <div class="mt-6 flex justify-center gap-4 text-sm text-gray-400">
          <a href="/login" class="hover:text-gray-600 transition">Login</a>
          <a href="#" class="hover:text-gray-600 transition">Términos del servicio</a>
        </div>

      </div>
    </div>
  </section>
</Layout>