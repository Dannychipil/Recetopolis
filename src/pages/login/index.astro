---
import LoginLayout from '@/layouts/LoginLayout.astro'

let error = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const email    = form.get('email')
  const password = form.get('password')

  const res = await fetch(`${Astro.url.origin}/api/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password })
  })

  if (res.ok) {
    const { token } = await res.json()
    Astro.cookies.set('token', token, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'strict',
      maxAge: 60 * 60 * 24 * 7
    })
    return Astro.redirect('/')
  } else {
    const data = await res.json()
    error = data.error || 'Error al iniciar sesión'
  }
}
---

<LoginLayout title="Iniciar sesión">
  <section class="min-h-screen bg-[#f3f1e9] flex items-center justify-center px-4">
    <div class="w-full max-w-xl">
      <div class="bg-[#F4F3EF] rounded-2xl shadow-lg p-8 md:p-10">

        <div class="text-center mb-8">
          <h1 class="text-5xl font-bold tracking-widest uppercase mb-2 text-[#6C4637]">Recetópolis</h1>
          <h2 class="text-2xl font-semibold text-[#5a3a2d]">Iniciar Sesión</h2>
        </div>

        {error && (
          <div class="bg-red-50 text-red-600 text-md px-4 py-3 rounded-lg mb-6">
            {error}
          </div>
        )}

        <form method="POST" class="space-y-4">
          <div class="flex flex-col gap-1">
            <label for="email" class="text-md font-medium text-[#5a3a2d]">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              placeholder="Ingrese su email"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <div class="flex flex-col gap-1">
            <label for="password" class="text-md font-medium text-[#5a3a2d]">Contraseña</label>
            <input
              type="password"
              name="password"
              id="password"
              placeholder="••••••••"
              required
              class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-gray-400 transition"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 mt-2 bg-[#6C4637] text-white rounded-xl font-semibold text-sm hover:bg-[#5a3a2d] transition"
          >
            Continuar
          </button>
        </form>

        <div class="mt-6 flex justify-center gap-4 text-sm text-gray-400">
          <a href="/register" class="hover:text-gray-600 transition whitespace-nowrap">Crear cuenta</a>
          <a href="#" class="hover:text-gray-600 transition whitespace-nowrap">Política de privacidad</a>
          <a href="#" class="hover:text-gray-600 transition whitespace-nowrap">Términos del servicio</a>
        </div>

      </div>
    </div>
  </section>
</LoginLayout>