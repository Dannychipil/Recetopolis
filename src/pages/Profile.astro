import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const recetasGuardadas = Array.from({ length: 4 });
---

<Layout>
    <Navbar />

    <main class="ml-64 bg-[#F4F3EF] min-h-screen p-8 overflow-x-hidden">

        <!-- HEADER PERFIL -->
        <section class="bg-white rounded-3xl shadow-md p-8 mb-10 border border-[#E7E2DA]">

            <div class="flex flex-col md:flex-row items-center gap-8">

                <!-- FOTO -->
                <div class="w-36 h-36 rounded-full overflow-hidden border-4 border-[#6C4637] shadow-lg flex-shrink-0">
                    <img
                        src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=400"
                        alt="Foto de perfil"
                        class="w-full h-full object-cover"
                    />
                </div>

                <!-- INFO -->
                <div class="flex-1 text-center md:text-left">

                    <h1 class="text-4xl font-bold text-[#6C4637] mb-2">
                        Nancy Ban
                    </h1>

                    <p class="text-gray-600 mb-4 max-w-2xl">
                        Amante de la cocina y de descubrir nuevas recetas 🍳
                        Compartiendo sabores, postres y comida casera.
                    </p>

                    <!-- STATS -->
                    <div class="flex flex-wrap gap-4 justify-center md:justify-start">

                        <div class="bg-[#F4F3EF] px-5 py-3 rounded-2xl">
                            <p class="text-2xl font-bold text-[#6C4637]">24</p>
                            <p class="text-sm text-gray-600">Recetas</p>
                        </div>

                        <div class="bg-[#F4F3EF] px-5 py-3 rounded-2xl">
                            <p class="text-2xl font-bold text-[#6C4637]">1.2k</p>
                            <p class="text-sm text-gray-600">Seguidores</p>
                        </div>

                        <div class="bg-[#F4F3EF] px-5 py-3 rounded-2xl">
                            <p class="text-2xl font-bold text-[#6C4637]">182</p>
                            <p class="text-sm text-gray-600">Likes</p>
                        </div>

                    </div>
                </div>

                <!-- BOTON -->
                <button
                    class="bg-[#6C4637] text-white px-6 py-3 rounded-2xl hover:scale-105 transition shadow-md"
                >
                    Editar perfil
                </button>

            </div>
        </section>

        <!-- MIS RECETAS -->
        <section class="mb-14">

            <div class="flex items-center justify-between mb-6">
                <h2 class="text-3xl font-bold text-[#6C4637]">
                    Mis recetas
                </h2>

                <button
                    class="bg-[#6C4637] text-white px-5 py-2 rounded-xl hover:scale-105 transition"
                >
                    + Nueva receta
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                {
                    recetasGuardadas.map(() => (
                        <Card />
                    ))
                }

            </div>
        </section>

        <!-- FAVORITOS -->
        <section>

            <h2 class="text-3xl font-bold text-[#6C4637] mb-6">
                Favoritos
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                {
                    recetasGuardadas.map(() => (
                        <Card />
                    ))
                }

            </div>
        </section>

    </main>

    <Footer />
</Layout>
