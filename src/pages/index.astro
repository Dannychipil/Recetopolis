---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

// Datos dinámicos
const recetasPopulares = Array.from({ length: 6 });
---

<Layout>
    <Navbar />

    <main class="ml-64 bg-[#F4F3EF] min-h-screen p-8 overflow-x-hidden">

        <!-- TITULO -->
        <h1 class="text-5xl text-center text-[#6C4637] font-bold mb-12">
            Recetópolis
        </h1>

        <!-- ================= POPULARES ================= -->
        <section class="mb-14">

            <div class="flex items-center justify-between mb-5">
                <h2 class="text-2xl font-semibold text-[#6C4637]">
                    Populares
                </h2>
            </div>

            <div class="relative flex items-center">

                <!-- BOTON IZQUIERDA -->
                <button
                    onclick="scrollCarousel('populares', -320)"
                    class="absolute left-0 z-10 bg-[#6C4637] text-white w-10 h-10 rounded-full shadow-lg hover:scale-110 transition flex items-center justify-center"
                >
                    ❮
                </button>

                <!-- CARRUSEL -->
                <div
                    id="populares"
                    class="flex gap-5 overflow-x-hidden scroll-smooth px-14 py-2 w-full scrollbar-hide"
                >

                    {
                        recetasPopulares.map(() => (
                            <Card />
                        ))
                    }

                </div>

                <!-- BOTON DERECHA -->
                <button
                    onclick="scrollCarousel('populares', 320)"
                    class="absolute right-0 z-10 bg-[#6C4637] text-white w-10 h-10 rounded-full shadow-lg hover:scale-110 transition flex items-center justify-center"
                >
                    ❯
                </button>

            </div>
        </section>

    </main>

    <Footer />
</Layout>

<script>
    function scrollCarousel(id, amount) {
        const container = document.getElementById(id);

        container.scrollBy({
            left: amount,
            behavior: "smooth"
        });
    }

    window.scrollCarousel = scrollCarousel;
</script>