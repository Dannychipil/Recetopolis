---
interface Review {
  _id: string;
  userName?: string;
  rating: number;
  comment: string;
  createdAt: string;
}

const { reviews } = Astro.props as { reviews: Review[] };
---

<section class="bg-white rounded-3xl p-6 shadow-sm border border-[#E7E2DA]">
  <h2 class="text-xl font-bold text-[#6C4637] mb-6">Reseñas</h2>

  {
    reviews.length === 0 ? (
      <div class="text-center py-8">
        <i class="fi fi-rr-comment text-4xl text-gray-300" />

        <p class="text-gray-400 mt-3">Aún no hay reseñas.</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-5">
        {reviews.map((review) => (
          <li class="border-b border-[#E7E2DA] pb-5 last:border-none">
            <div class="flex items-center justify-between mb-2">
              <div>
                <p class="font-semibold text-[#6C4637]">{review.userName}</p>

                <p class="text-xs text-gray-400">
                  {new Date(review.createdAt).toLocaleDateString()}
                </p>
              </div>

              <div class="flex items-center gap-1 text-yellow-500">
                <i class="fi fi-sr-star" />
                <span>{review.rating}</span>
              </div>
            </div>

            <p class="text-gray-600 leading-relaxed">{review.comment}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>
