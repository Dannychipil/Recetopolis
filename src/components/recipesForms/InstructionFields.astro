---
interface Props {
  instructions?: string[];
}

const { instructions = [] } = Astro.props;
---

<div class="flex flex-col gap-3">
  <label class="text-sm font-medium text-gray-600"> Instrucciones </label>

  <div id="instructions-list" class="flex flex-col gap-2">
    {
      instructions.map((instruction, index) => (
        <div class="flex gap-2 items-start">
          <span
            data-step-number
            class="mt-2 text-sm font-bold text-[#6C4637] w-6 shrink-0"
          >
            {index + 1}.
          </span>

          <textarea
            rows="2"
            data-instruction
            class="flex-1 px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-[#6C4637] resize-none"
          >
            {instruction}
          </textarea>

          <button
            type="button"
            class="remove-instruction mt-2 text-red-400 hover:text-red-600 text-lg"
          >
            ✕
          </button>
        </div>
      ))
    }
  </div>

  <button
    type="button"
    id="add-instruction"
    class="self-start text-sm text-[#6C4637] border border-[#6C4637] px-4 py-2 rounded-xl hover:bg-[#6C4637] hover:text-white transition"
  >
    + Agregar paso
  </button>
</div>
