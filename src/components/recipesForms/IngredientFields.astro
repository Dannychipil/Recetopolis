---
interface Ingredient {
  name: string;
  quantity: string;
  unit: string;
}

interface Props {
  ingredients?: Ingredient[];
}

const { ingredients = [] } = Astro.props;
---

<div class="flex flex-col gap-3">
  <label class="text-sm font-medium text-gray-600"> Ingredientes </label>

  <div id="ingredients-list" class="flex flex-col gap-2">
    {
      ingredients.map((ingredient) => (
        <div class="grid grid-cols-3 gap-2 items-center">
          <input
            type="text"
            data-ingredient="name"
            value={ingredient.name}
            placeholder="Nombre"
            class="px-3 py-2 border border-gray-200 rounded-xl text-sm"
          />

          <input
            type="text"
            data-ingredient="quantity"
            value={ingredient.quantity}
            placeholder="Cantidad"
            class="px-3 py-2 border border-gray-200 rounded-xl text-sm"
          />

          <div class="flex gap-2">
            <input
              type="text"
              data-ingredient="unit"
              value={ingredient.unit}
              placeholder="Unidad"
              class="flex-1 px-3 py-2 border border-gray-200 rounded-xl text-sm"
            />

            <button
              type="button"
              class="remove-ingredient text-red-400 hover:text-red-600 text-lg"
            >
              ✕
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <button
    type="button"
    id="add-ingredient"
    class="self-start text-sm text-[#6C4637] border border-[#6C4637] px-4 py-2 rounded-xl hover:bg-[#6C4637] hover:text-white transition"
  >
    + Agregar ingrediente
  </button>
</div>
